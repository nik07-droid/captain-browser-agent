{
  "name": "captain-browser-agent",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first voice browser agent built on UI-TARS concepts",
  "scripts": {
    "start": "node server/index.mjs",
    "demo": "node scripts/start-demo.mjs",
    "reload": "node scripts/reload-in-place.mjs",
    "diagnose": "node scripts/diagnose-controller.mjs",
    "test:e2e": "node scripts/e2e-demo.mjs",
    "test:playback": "node scripts/audit-playback.mjs",
    "test:request": "node scripts/audit-request.mjs",
    "test:panel": "node scripts/audit-panel.mjs",
    "test:websites": "node scripts/audit-websites.mjs",
    "test:visual-privacy": "node scripts/audit-visual-privacy.mjs",
    "test:shopping": "node scripts/audit-shopping.mjs",
    "test:amazon": "node scripts/audit-amazon.mjs",
    "benchmark:amazon-latency": "node scripts/benchmark-amazon-latency.mjs 5",
    "test:privacy-attack": "node --test tests/privacy-attack.test.mjs",
    "test:acceptance": "node scripts/acceptance.mjs",
    "test:handoff": "node scripts/audit-handoff.mjs",
    "test:vlm": "node scripts/audit-vlm.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node --check server/index.mjs && node --check extension/service-worker.js && node --check extension/content-script.js && tsc -p tsconfig.json --noEmit",
    "package": "npm run package:extension",
    "kws:check": "node scripts/check-kws.mjs",
    "kws:capture": "python kws/capture.py",
    "kws:train": "python kws/train.py",
    "kws:verify": "python kws/verify_budget.py",
    "dev": "node --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server/index.mjs && node --check extension/service-worker.js && node --check extension/content-script.js && npm test",
    "package:extension": "node scripts/package.mjs",
    "test:firefox-static": "npm run package:extension && node scripts/check-firefox.mjs",
    "test:firefox": "npm run test:firefox-static"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
