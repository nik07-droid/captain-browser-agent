{
  "manifest_version": 3,
  "incognito": "split",
  "name": "CAPTAIN — Private Browser Agent",
  "version": "0.5.0",
  "description": "Voice browser automation with local perception and PII redaction.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:4317/*",
    "http://localhost:4317/*",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "service-worker.js"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CAPTAIN"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "captain@local.sih",
      "strict_min_version": "121.0"
    }
  }
}
